# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
package-lock.json
yarn.lock

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Next.js
.next/
out/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# macOS
.DS_Store
*.pem

# local env files (all apps)
.env
.env.local
.env.production
.env*.local
aladb.env

# typescript
*.tsbuildinfo

# Skia web WASM (copied by postinstall / skia:web)
**/public/canvaskit.wasm

# generated native folders
/ios
/android
apps/mobile/ios
apps/mobile/android

# scratch output from local scripts and smoke runs (kept on disk, never committed)
.tmp/
.smoke/

# Playwright MCP screenshots and traces (local evidence, never committed)
.playwright-mcp/

# Disaster recovery: only tooling/templates belong in Git; runtime data and state stay external.
__pycache__/
*.pyc
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tar.age
*.tar.age.*
infrastructure/**/*.env
infrastructure/**/upstream/
web-desktop-card-feed-*.png
.fixtures/
