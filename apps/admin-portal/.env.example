NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# This portal is read-only oversight (Overview / Reports / Money / Soft-Wall / Profile / Features /
# People) — same RPCs and app_runtime_config Expo /admin reads/writes, no edit affordance here.
# Every change (Features/Look flags, Games, Drip SKUs, Sports, Catalogs, everything) happens only in
# Expo /admin (`pnpm mobile` → http://localhost:8081/admin).
# Copy EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY from apps/mobile/.env.local.

# Auth: this portal requires a Supabase Auth sign-in (email/password or magic link, /login) AND
# profiles.is_admin = true on that account (same gate Expo /admin uses). Create/grant an admin account
# either in the Supabase dashboard (Authentication -> Users, then `update profiles set is_admin = true, role = 'admin'
# where user_id = '<auth user id>'` — user_id, not id; profiles.id is its own key), or sign up once via /login and have an existing admin flip it on from Expo
# /admin/people. There is no default admin account — the portal has no seeded credentials.

# SCALE-01 admin two-step sign-in (Supabase Auth TOTP). OFF unless set to true / 1 / on / yes.
# When on, every portal desk refuses a session that is not aal2 and sends the admin to /login/mfa to
# set up an authenticator app or enter its code. Turn on TOTP in the Supabase dashboard first
# (Authentication -> Multi-Factor), then restart `pnpm admin` (Next reads NEXT_PUBLIC_* at start).
# Steps: docs/engineering/ADMIN_MFA.md
# NEXT_PUBLIC_ADMIN_REQUIRE_MFA=true
