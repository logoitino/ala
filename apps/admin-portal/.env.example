NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Reports / Money on the web portal (`pnpm admin` → http://localhost:3001/reports and /money).
# Same RPCs as Expo `/admin/reports` and `/admin/money`.
# Copy EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY from apps/mobile/.env.local.
# Features toggles call patch_app_runtime_draft + publish_app_runtime (Realtime to the fan app).
# Games, Drip SKUs, Sports, catalogs still edit in Expo /admin.

# Auth: this portal requires a Supabase Auth sign-in (email/password or magic link, /login) AND
# profiles.is_admin = true on that account (same gate Expo /admin uses). Create/grant an admin account
# either in the Supabase dashboard (Authentication -> Users, then `update profiles set is_admin = true
# where id = '<user id>'`), or sign up once via /login and have an existing admin flip it on from Expo
# /admin/people. There is no default admin account — the portal has no seeded credentials.
