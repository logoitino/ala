# Public mobile build settings; server-only credential loading notes contain no server secret values.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Stripe secret: keep it OUT of this file. Checkout and Connect run in the Supabase Edge Functions,
# which read the secret set with `supabase secrets set STRIPE_SECRET_KEY=...`. Only the local Metro
# fallback routes (/api/*) read their server process environment; if you need them, keep keys outside the
# repo and load it into the shell before starting Expo:
#   set -a; source ~/.config/ala-sports/stripe-secret.env; set +a; pnpm mobile
# Connect’s Metro fallback also requires SUPABASE_SERVICE_ROLE_KEY in that private server environment.
# Never put either server credential in this public template or an EXPO_PUBLIC_* variable.

# Hosted Expo API origin for installed builds (e.g. https://ala-sports.expo.app). Leave unset in
# development — Metro answers /api/* itself. Checkout uses the create-payment-intent Edge Function
# first, so testers only need this if that function is not deployed.
# EXPO_PUBLIC_API_ORIGIN=

# SCALE-03 live scores over per-game Broadcast. Leave off until supabase/migrations/20261018120000_live_score_broadcast.sql
# is applied on the project this build points at. Off (or a refused topic) keeps the earlier full-refetch path.
# EXPO_PUBLIC_LIVE_SCORES_BROADCAST=true

# Soft-Wall auth (optional notes — providers are toggled in Supabase Dashboard)
# Redirect URI to allow in Auth → URL Configuration:
#   alasports://auth/callback
# Enable: Email (password + magic link), Apple, Google under Authentication → Providers.
# For Demo Fan one-tap login, turn OFF “Confirm email” (or pre-create the user).
# Apple Sign In also needs the expo-apple-authentication plugin (already in app.json).
#
# Demo Fan account (SoftWall → Continue as Demo Fan)
EXPO_PUBLIC_DEMO_FAN_EMAIL=demo@tapuai.app
EXPO_PUBLIC_DEMO_FAN_PASSWORD=TapuaiDemoFan1!

# SCALE-01 admin two-step sign-in for Expo /admin (Supabase Auth TOTP). OFF unless true / 1 / on / yes.
# When on, admin desks open only for an aal2 session; Studio unlock no longer opens them.
# Restart Metro with --clear after changing it (EXPO_PUBLIC_* is inlined). Steps: docs/engineering/ADMIN_MFA.md
# EXPO_PUBLIC_ADMIN_REQUIRE_MFA=true
