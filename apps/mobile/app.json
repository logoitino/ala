{
  "expo": {
    "name": "ala-sports",
    "slug": "ala-sports",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "alasports",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.logoitino.ala-sports"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tapua'i to confirm you are at the field for operator check-in."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tapua'i to pick a Seki play or profile photo from your camera roll.",
          "cameraPermission": "Allow Tapua'i to record a Seki play.",
          "microphonePermission": "Allow Tapua'i to record audio with your clip."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Tapua'i to save a flyer-ready QR so family can support this athlete.",
          "savePhotosPermission": "Allow Tapua'i to save a flyer-ready QR to your camera roll.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.alasports.tapuai",
          "enableGooglePay": false
        }
      ],
      "expo-video",
      "expo-web-browser",
      "react-native-compressor"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
