# Private local server configuration template for Stripe TEST bank setup.
# Copy outside the repository, e.g. ~/.config/ala-sports/app-test-server.env, and chmod 600.
# Fill privately. Do not commit credentials or put these variables in apps/mobile/.env.local.
# The development Supabase Dashboard supplies the service-role key; never expose it to the client.
# Hosted Edge Functions receive SUPABASE_SERVICE_ROLE_KEY from Supabase automatically.
STRIPE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Payment receipt/webhook testing additionally requires a verified endpoint signing secret.
# It is not needed merely to open the Connect bank portal.
STRIPE_WEBHOOK_SECRET=
