# Private operator copy: /etc/tapuai/backup.env, chmod 600. Never load into frontend builds.
# Match pg_dump major version to the SOURCE server. Remote TLS requires a trusted root.
PGHOST=source-db.example.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSFILE=/etc/tapuai/source.pgpass
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/tapuai/source-ca.crt
SUPABASE_SOURCE_URL=https://source.example.com
SUPABASE_SOURCE_SERVICE_ROLE_KEY=replace-with-server-only-source-service-key
