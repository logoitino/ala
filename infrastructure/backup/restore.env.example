# Private isolated target copy: /etc/tapuai/restore.env, chmod 600.
# Use an isolated database, outbound SMTP/payment blocks, separate secrets and no public traffic.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=postgres
PGUSER=postgres
PGPASSFILE=/etc/tapuai/target.pgpass
PGSSLMODE=disable
SUPABASE_TARGET_URL=http://127.0.0.1:8000
SUPABASE_TARGET_SERVICE_ROLE_KEY=replace-with-server-only-target-service-key
