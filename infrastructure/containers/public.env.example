# Public build configuration only. Use /etc/tapuai/public.env outside the checkout.
RELEASE_TAG=replace-with-reviewed-source-sha
FAN_DOMAIN=fan.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
SUPABASE_PUBLIC_URL=https://api.example.com
SUPABASE_ANON_KEY=replace-with-public-anonymous-key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_public_key
APP_ENV=production
ADMIN_REQUIRE_MFA=true
LIVE_SCORES_BROADCAST=false
SUPPORT_SENSORS_ENABLED=false
# Pin independently reviewed official Node 24 and Caddy image digests; no mutable image default.
NODE_IMAGE=node:24-bookworm-slim@sha256:replace-with-reviewed-image-digest
CADDY_IMAGE=caddy@sha256:replace-with-reviewed-image-digest
FAN_RUNTIME_ENV_FILE=/etc/tapuai/fan-runtime.env
ADMIN_RUNTIME_ENV_FILE=/etc/tapuai/admin-runtime.env
