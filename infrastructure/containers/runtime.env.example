# Private runtime inventory: replace placeholders in external mode-0600 files, never in Git.
# Fan API reads these at startup; the read-only portal needs no service-role or Stripe secret.
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-target-service-role-key
STRIPE_SECRET_KEY=sk_test_replace_with_target_test_secret
# Fan server handlers also read public SDK names at runtime (built clients already have them).
EXPO_PUBLIC_SUPABASE_URL=https://api.example.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anonymous-key
