{
  "name": "tapuai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "start": "pnpm mobile",
    "mobile": "pnpm --filter @tapuai/mobile start",
    "mobile:ios": "pnpm --filter @tapuai/mobile ios",
    "mobile:android": "pnpm --filter @tapuai/mobile android",
    "mobile:web": "pnpm --filter @tapuai/mobile web",
    "admin": "pnpm --filter @tapuai/admin-portal dev",
    "admin:build": "pnpm --filter @tapuai/admin-portal build",
    "portal:test": "bash -lc 'cd apps/admin-portal && node --import ./lib/analytics-resolver.mjs --test lib/*.test.ts'",
    "docs:sync": "node scripts/sync-front-docs.mjs",
    "docs:check": "node scripts/sync-front-docs.mjs --check",
    "life:bank:check": "node scripts/life-bank-sql.mjs --check",
    "docs:links": "node scripts/check-doc-links.mjs",
    "security:client-keys": "node scripts/check-client-keys.mjs",
    "security:no-ssn": "node scripts/check-no-ssn.mjs",
    "infra:register": "node scripts/infra-register.mjs",
    "infra:register:check": "node scripts/infra-register.mjs --check",
    "layers:sync": "node scripts/build-layers.mjs",
    "layers:check": "node scripts/build-layers.mjs --check",
    "exit:map": "node scripts/exit-map.mjs",
    "exit:map:check": "node scripts/exit-map.mjs --check",
    "exit:status": "node scripts/exit-map.mjs --status",
    "exit:preflight": "node scripts/exit-map.mjs --preflight",
    "db:types": "node scripts/gen-db-types.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "app:data-boundaries": "node scripts/check-app-data-boundaries.mjs",
    "comments:check": "node scripts/check-comments.mjs",
    "agents:check": "node scripts/check-agents.mjs",
    "typecheck": "pnpm --filter @tapuai/mobile typecheck && pnpm --filter @tapuai/admin-portal typecheck",
    "test": "pnpm --filter @tapuai/mobile test -- --watchman=false",
    "app:test:media": "node scripts/media-test-assets.mjs",
    "app:test:assets": "node --test scripts/__tests__/media-test-assets.test.mjs",
    "metro:test": "node --test scripts/__tests__/metro-request-abort.test.mjs",
    "check": "pnpm ip:sync && pnpm ip:check && pnpm ip:test && pnpm typecheck && pnpm test && pnpm app:test:assets && pnpm metro:test && pnpm docs:check && pnpm docs:links && pnpm copy:check && pnpm life:bank:check && pnpm app:data-boundaries && pnpm comments:check && pnpm feature-admin:test && pnpm feature-admin:check && pnpm portal:test && pnpm data:map:check && pnpm code:unused && pnpm recovery:test && pnpm redundancy:test && pnpm detection:test && pnpm detection:check && pnpm agents:check && pnpm security:client-keys && pnpm security:no-ssn && pnpm infra:register:check && pnpm layers:check && pnpm exit:test && pnpm portability:test && pnpm security:infra:test && pnpm security:infra:check && pnpm exit:map:check && pnpm exit:sync ensure",
    "feature-admin:check": "node scripts/check-feature-admin.mjs",
    "feature-admin:test": "node --test scripts/__tests__/check-feature-admin.test.mjs",
    "data:map": "node scripts/data-map.mjs",
    "data:map:check": "node --test scripts/__tests__/media-storage-lineage.test.mjs && node scripts/data-map.mjs --check",
    "detection:check": "node scripts/detection.mjs --check",
    "detection:test": "node --test scripts/__tests__/detection.test.mjs",
    "detection:scan": "node scripts/detection.mjs --scan",
    "code:unused": "node scripts/check-unused.mjs",
    "recovery:package": "node scripts/recovery-capsule.mjs package",
    "recovery:verify": "node scripts/recovery-capsule.mjs verify",
    "recovery:restore": "node scripts/recovery-capsule.mjs restore",
    "recovery:test": "node --test scripts/__tests__/recovery-capsule.test.mjs",
    "redundancy:doctor": "python3 infrastructure/backup/doctor.py",
    "redundancy:test": "python3 -m unittest discover -s infrastructure/backup/tests -v && python3 -m unittest discover -s infrastructure/migration/tests -v && python3 -m unittest discover -s infrastructure/supabase/tests -v && node infrastructure/containers/expo-server.test.mjs",
    "backup:create": "python3 infrastructure/backup/backup.py",
    "backup:verify": "python3 infrastructure/backup/verify.py",
    "backup:restore": "python3 infrastructure/backup/restore.py",
    "backup:publish": "python3 infrastructure/backup/publish.py",
    "backup:job": "python3 infrastructure/backup/job.py",
    "backup:status": "python3 infrastructure/backup/status.py",
    "backup:fetch": "python3 infrastructure/backup/fetch.py",
    "exit:inventory": "node scripts/exit-map.mjs --json",
    "exit:release": "node infrastructure/exit/release.mjs",
    "exit:readiness": "python3 infrastructure/exit/readiness.py",
    "exit:images": "python3 infrastructure/exit/runtime_images.py",
    "exit:test": "node --test scripts/__tests__/exit-map.test.mjs infrastructure/exit/tests/release.test.mjs infrastructure/exit/tests/sync.test.mjs infrastructure/exit/tests/setup.test.mjs infrastructure/exit/tests/health-source.test.mjs scripts/__tests__/exit-workflow.test.mjs && python3 -m unittest discover -s infrastructure/exit/tests -v",
    "exit:sync": "node infrastructure/exit/sync.mjs",
    "exit:watch": "node infrastructure/exit/sync.mjs watch",
    "exit:sync:status": "node infrastructure/exit/sync.mjs status",
    "exit:setup": "node infrastructure/exit/setup.mjs",
    "exit:health": "python3 infrastructure/exit/health.py",
    "portability:profile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON infrastructure/portability/profile.mjs",
    "portability:protocol": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON infrastructure/portability/protocol.mjs",
    "portability:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test infrastructure/portability/tests/*.test.mjs",
    "security:infra": "node infrastructure/security/report.mjs --write",
    "security:infra:check": "node infrastructure/security/report.mjs --check",
    "security:infra:report": "node infrastructure/security/report.mjs --json",
    "security:infra:test": "node --test infrastructure/security/tests/*.test.mjs",
    "ip:sync": "node scripts/ip-docs.mjs",
    "ip:check": "node scripts/ip-docs.mjs --check",
    "ip:test": "node --test scripts/__tests__/ip-docs.test.mjs"
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-video@58.0.11": "patches/expo-video@58.0.11.patch",
      "expo@58.0.14": "patches/expo@58.0.14.patch",
      "@expo/router-server@58.0.14": "patches/@expo__router-server@58.0.14.patch"
    }
  }
}
