{
  "name": "tapuai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "start": "pnpm mobile",
    "mobile": "pnpm --filter @tapuai/mobile start",
    "mobile:ios": "pnpm --filter @tapuai/mobile ios",
    "mobile:android": "pnpm --filter @tapuai/mobile android",
    "mobile:web": "pnpm --filter @tapuai/mobile web",
    "admin": "pnpm --filter @tapuai/admin-portal dev",
    "admin:build": "pnpm --filter @tapuai/admin-portal build",
    "docs:sync": "node scripts/sync-front-docs.mjs",
    "docs:check": "node scripts/sync-front-docs.mjs --check",
    "docs:links": "node scripts/check-doc-links.mjs",
    "security:client-keys": "node scripts/check-client-keys.mjs",
    "security:no-ssn": "node scripts/check-no-ssn.mjs",
    "infra:register": "node scripts/infra-register.mjs",
    "infra:register:check": "node scripts/infra-register.mjs --check",
    "db:types": "node scripts/gen-db-types.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "app:data-boundaries": "node scripts/check-app-data-boundaries.mjs",
    "comments:check": "node scripts/check-comments.mjs",
    "agents:check": "node scripts/check-agents.mjs",
    "typecheck": "pnpm --filter @tapuai/mobile typecheck && pnpm --filter @tapuai/admin-portal typecheck",
    "test": "pnpm --filter @tapuai/mobile test -- --watchman=false",
    "check": "pnpm typecheck && pnpm test && pnpm docs:check && pnpm docs:links && pnpm copy:check && pnpm app:data-boundaries && pnpm comments:check && pnpm feature-admin:test && pnpm feature-admin:check && pnpm data:map:check && pnpm code:unused && pnpm recovery:test && pnpm detection:test && pnpm detection:check && pnpm agents:check && pnpm security:client-keys && pnpm security:no-ssn && pnpm infra:register:check",
    "feature-admin:check": "node scripts/check-feature-admin.mjs",
    "feature-admin:test": "node --test scripts/__tests__/check-feature-admin.test.mjs",
    "data:map": "node scripts/data-map.mjs",
    "data:map:check": "node scripts/data-map.mjs --check",
    "detection:check": "node scripts/detection.mjs --check",
    "detection:test": "node --test scripts/__tests__/detection.test.mjs",
    "detection:scan": "node scripts/detection.mjs --scan",
    "code:unused": "node scripts/check-unused.mjs",
    "recovery:package": "node scripts/recovery-capsule.mjs package",
    "recovery:verify": "node scripts/recovery-capsule.mjs verify",
    "recovery:restore": "node scripts/recovery-capsule.mjs restore",
    "recovery:test": "node --test scripts/__tests__/recovery-capsule.test.mjs"
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-video@57.0.5": "patches/expo-video@57.0.5.patch"
    }
  }
}
